#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the acme-dns service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
#
# Deliberately thin: every option is read from /data/options.json by config.py,
# so there is no per-option bashio plumbing to keep in sync with config.yaml.
# ==============================================================================

bashio::log.info "Starting acme-dns..."

# Via /usr/sbin/acme-dns rather than python3 directly, so AppArmor can attach
# the service's nested profile to an exact path. See apparmor.txt.
exec /usr/sbin/acme-dns
